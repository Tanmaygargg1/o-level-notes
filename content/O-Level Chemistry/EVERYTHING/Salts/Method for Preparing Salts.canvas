			"y":-200,
			"width":250,
			"height":100,
			"color":"3"
		},
		{
			"id":"efdd837c783d40f1",
			"type":"text",
			"text":"Method 3: [[Precipitation Method for Preparing Salts]]\n* solution containing cation of the salt + solution containing anion of the salt. ",
			"styleAttributes":{},
			"x":371,
			"y":56,
			"width":250,
			"height":329,
			"color":"3"
		},
		{
			"id":"9d506d028c48053c",
			"type":"text",
			"text":"Reaction of an acid with a metal, base or carbonate",
			"styleAttributes":{},
			"x":-473,
			"y":80,
			"width":251,
			"height":100,
			"color":"5"
		},
		{
			"id":"4e61970e899bbec7",
			"type":"text",
			"text":"Yes",
			"styleAttributes":{},
			"x":-274,
			"y":-34,
			"width":103,
			"height":50
		},
		{
			"id":"06958de07b17ab04",
			"type":"text",
			"text":"Method 2: [[Titration method for preparing salts]]\n* acid + alkali (soluble base)\n* Acid + soluble carbonate",
			"styleAttributes":{},
			"x":20,
			"y":440,
			"width":250,
			"height":260,
			"color":"3"
		},
