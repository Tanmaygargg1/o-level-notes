			"y":1080,
			"width":100,
			"height":60,
			"color":"1"
		},
		{
			"id":"c7735dc17cb00e24",
			"type":"text",
			"text":"2. are both the starting materials soluble in water? ",
			"styleAttributes":{},
			"x":-473,
			"y":220,
			"width":250,
			"height":125
		},
		{
			"id":"eb7e2e52a6ae8302",
			"type":"text",
			"text":"1. is the salt to be prepared soluble in water. ",
