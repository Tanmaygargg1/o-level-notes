		},
		{
			"id":"aa9ab1607b087994",
			"type":"text",
			"text":"Method 2: Titration method for preparing salts\n* Base + alkali (soluble base)\n* Acid + soluble carbonate\n",
			"styleAttributes":{},
			"x":1083,
			"y":623,
			"width":250,
			"height":217,
			"color":"4"
		},
		{
			"id":"762e628103b853ce",
			"type":"text",
			"text":"Method 1: Preparing salt by reaction of acid with an excess insoluble substance. \n* Acid + excess metal\n* Acid + excess insoluble base\n* Acid + excess insoluble carbonate\n",
			"styleAttributes":{},
			"x":321,
			"y":806,
			"width":250,
			"height":274,
			"color":"4"
		},
