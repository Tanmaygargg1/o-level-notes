			"text":"5",
			"styleAttributes":{},
			"x":614,
			"y":320,
			"width":60,
			"height":60
		},
		{
			"id":"9bc043a6e3b3643d",
			"type":"text",
			"text":"Body temperature increases\n* Hypothalamus detects this change (due to thermoreceptors in the hypothalamus which detect body blood temp.)\n* Sends nerve impulses to relevant body parts to reduce the opposite effects. ",
			"styleAttributes":{},
			"x":826,
